<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SPUTNIK</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --red:#C81E1E; --ink:#111111; --cream:#F2EEE6; --gold:#C9A54A; --steel:#7C7F82;
    box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *{box-sizing:border-box;}
  html{scroll-padding-top:env(safe-area-inset-top,0px);}
  html,body{height:100%; margin:0;}
  body{
    background:var(--cream); color:var(--ink); font-family:'IBM Plex Sans',sans-serif;
    display:flex; flex-direction:column; overflow:hidden;
  }
  .header{
    padding:calc(14px + env(safe-area-inset-top,0px)) 18px 12px;
    background:var(--ink); color:var(--cream); display:flex; align-items:center; gap:10px;
    border-bottom:4px solid var(--red);
  }
  .logo{
    width:30px;height:30px; border-radius:50%; border:3px solid var(--red);
    position:relative; flex-shrink:0;
  }
  .logo::after{
    content:''; position:absolute; width:44px; height:2px; background:var(--gold);
    top:50%; left:50%; transform:translate(-50%,-50%) rotate(-30deg);
  }
  .wordmark{font-family:'Oswald',sans-serif; font-weight:700; font-size:22px; letter-spacing:1px;}
  .wordmark span{color:var(--red);}
  main{flex:1; overflow-y:auto; padding:16px 16px 90px;}
  .screen{display:none;}
  .screen.active{display:block; animation:fade .25s ease;}
  @keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

  h1{font-family:'Oswald',sans-serif; font-size:26px; margin:4px 0 4px; font-weight:700;}
  .sub{color:var(--steel); font-size:14px; margin-bottom:18px;}

  /* CHAT */
  .bubble{max-width:80%; padding:10px 14px; border-radius:14px; margin-bottom:10px; font-size:15px; line-height:1.4;}
  .bubble.user{background:var(--ink); color:var(--cream); margin-left:auto; border-bottom-right-radius:3px;}
  .bubble.ai{background:#fff; border:1px solid #e3ddcf; margin-right:auto; border-bottom-left-radius:3px;}

  /* IMAGE */
  .grid{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .tile{aspect-ratio:1; border-radius:8px; background:linear-gradient(135deg,var(--red),var(--ink)); position:relative; overflow:hidden;}
  .tile:nth-child(2){background:linear-gradient(135deg,var(--gold),var(--ink));}
  .tile:nth-child(3){background:linear-gradient(135deg,var(--steel),var(--ink));}
  .tile:nth-child(4){background:linear-gradient(135deg,var(--ink),var(--red));}
  .tile::after{content:'';position:absolute; inset:0; background:repeating-linear-gradient(45deg,rgba(255,255,255,.06) 0 2px, transparent 2px 8px);}

  /* CODE */
  .code-box{background:var(--ink); color:#d9d4c4; border-radius:10px; padding:14px; font-family:monospace; font-size:13px; line-height:1.6; overflow-x:auto;}
  .code-box .c1{color:var(--gold);} .code-box .c2{color:#8fd18f;} .code-box .c3{color:var(--red);}

  /* VOICE */
  .voice-wrap{display:flex; flex-direction:column; align-items:center; margin-top:40px;}
  .mic{
    width:88px;height:88px; border-radius:50%; background:var(--red); display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 0 8px rgba(200,30,30,.15);
  }
  .mic::after{content:''; width:26px; height:38px; border-radius:14px; background:var(--cream);}
  .wave{display:flex; gap:4px; align-items:flex-end; height:40px; margin-top:26px;}
  .wave span{width:4px; background:var(--ink); border-radius:2px; animation:bar 1.1s ease-in-out infinite;}
  .wave span:nth-child(1){height:12px; animation-delay:0s;}
  .wave span:nth-child(2){height:28px; animation-delay:.1s;}
  .wave span:nth-child(3){height:40px; animation-delay:.2s;}
  .wave span:nth-child(4){height:20px; animation-delay:.3s;}
  .wave span:nth-child(5){height:32px; animation-delay:.4s;}
  .wave span:nth-child(6){height:14px; animation-delay:.5s;}
  @keyframes bar{0%,100%{transform:scaleY(.4);} 50%{transform:scaleY(1);}}

  .inputbar{
    position:fixed; bottom:64px; left:0; right:0; padding:0 16px;
  }
  .inputbar input{
    width:100%; padding:12px 16px; border-radius:24px; border:1px solid #ddd5c2; background:#fff; font-size:15px;
  }

  nav{
    position:fixed; bottom:0; left:0; right:0; background:var(--ink); display:flex;
    padding-bottom:env(safe-area-inset-bottom,0px); border-top:2px solid var(--red);
  }
  nav button{
    flex:1; background:none; border:none; color:#8a8a8a; padding:12px 4px 10px; font-family:'Oswald',sans-serif;
    font-size:11px; letter-spacing:.5px; display:flex; flex-direction:column; align-items:center; gap:5px;
  }
  nav button .dot{width:8px;height:8px;border-radius:50%; background:#8a8a8a;}
  nav button.active{color:var(--cream);}
  nav button.active .dot{background:var(--red);}

  :root:not([data-theme="light"]) { }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){ }
  }

  .inputbar{display:flex;gap:8px;align-items:center}
  .inputbar input{flex:1;min-width:0}
  #go{background:var(--red);color:#fff;border:0;border-radius:10px;font-size:20px;padding:10px 16px}
  #codelog .code-box{white-space:pre-wrap;margin-bottom:10px}
  #imglog .tile img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
  .bubble{white-space:pre-wrap}
</style>
</head>
<body>

<div class="header">
  <div class="logo"></div>
  <div class="wordmark">SPU<span>TNIK</span></div>
</div>

<main>
  <section class="screen active" id="chat">
    <h1>Texte</h1>
    <div class="sub">Un compagnon pour écrire, réfléchir, décider.</div>
    <div id="chatlog"></div>
  </section>

  <section class="screen" id="image">
    <h1>Image</h1>
    <div class="sub">Décris, génère, affine.</div>
    <div class="grid" id="imglog"></div>
  </section>

  <section class="screen" id="code">
    <h1>Code</h1>
    <div class="sub">De l'idée au script qui tourne.</div>
    <div id="codelog"></div>
  </section>

  <section class="screen" id="voice">
    <h1>Voix</h1>
    <div class="sub">Parle, on s'occupe du reste.</div>
    <div class="voice-wrap">
      <div class="mic" id="mic"></div>
      <div id="voicelog"></div>
      <div class="wave"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </div>
  </section>
</main>

<div class="inputbar"><input id="msg" type="text" placeholder="Écris à SPUTNIK…" enterkeyhint="send"><button id="go">→</button></div>

<nav>
  <button class="active" data-target="chat"><span class="dot"></span>TEXTE</button>
  <button data-target="image"><span class="dot"></span>IMAGE</button>
  <button data-target="code"><span class="dot"></span>CODE</button>
  <button data-target="voice"><span class="dot"></span>VOIX</button>
</nav>

<script>
  document.querySelectorAll('nav button').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.target).classList.add('active');
    });
  });
  const API=location.hostname.endsWith('onrender.com')?'':'https://sputnik-server.onrender.com';
  const $=id=>document.getElementById(id), hist={chat:[],code:[]};
  async function post(p,b){
    const r=await fetch(API+p,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(b)});
    const d=await r.json(); if(!r.ok) throw new Error(d.error||'Erreur'); return d;
  }
  function add(box,cls,txt){const d=document.createElement('div');d.className=cls;d.textContent=txt;box.appendChild(d);d.scrollIntoView({block:'end'});return d;}
  async function ask(kind,text,box,cls){
    add(box,'bubble user',text); const w=add(box,cls,'…');
    try{
      const d=await post('/api/'+kind,{message:text,history:hist[kind]});
      hist[kind].push({role:'user',content:text},{role:'assistant',content:d.reply});
      w.textContent=d.reply; return d.reply;
    }catch(e){w.textContent='Erreur : '+e.message;}
  }
  async function send(){
    const t=$('msg').value.trim(); if(!t) return; $('msg').value='';
    const tab=document.querySelector('.screen.active').id;
    if(tab==='code'){ const w=add($('codelog'),'code-box','…');
      try{const d=await post('/api/code',{message:t,history:hist.code});
        hist.code.push({role:'user',content:t},{role:'assistant',content:d.reply}); w.textContent=d.reply;}
      catch(e){w.textContent='Erreur : '+e.message;} }
    else if(tab==='image'){ const tile=document.createElement('div');tile.className='tile';tile.textContent='…';$('imglog').prepend(tile);
      try{const d=await post('/api/image',{prompt:t}); tile.textContent='';
        const i=new Image(); i.src='data:image/png;base64,'+d.image_base64; tile.appendChild(i);}
      catch(e){tile.textContent='Erreur';alert(e.message);} }
    else if(tab==='voice'){ const a=await ask('chat',t,$('voicelog'),'bubble ai');
      if(a&&window.speechSynthesis){const u=new SpeechSynthesisUtterance(a);u.lang='fr-FR';speechSynthesis.speak(u);} }
    else ask('chat',t,$('chatlog'),'bubble ai');
  }
  $('go').onclick=send; $('msg').addEventListener('keydown',e=>{if(e.key==='Enter')send();});
  $('mic').onclick=()=>{
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR) return alert('Micro non supporté sur ce navigateur.');
    const r=new SR(); r.lang='fr-FR';
    r.onresult=e=>{$('msg').value=e.results[0][0].transcript; send();};
    r.start();
  };
</script>
</body>
</html>
